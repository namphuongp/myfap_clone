{
  "name": "myfap-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:init": "node --env-file=.env src/scripts/init-db.js",
    "db:replica": "node --env-file=.env src/scripts/init-replica.js",
    "seed": "node --env-file=.env src/scripts/seed.js",
    "seed:transfer-demo": "node --env-file=.env src/scripts/seed-transfer-demo.js",
    "import:legacy": "node --env-file=.env src/scripts/import-legacy.js",
    "slots:preview": "node --env-file=.env src/scripts/repair-legacy-slots.js",
    "slots:repair": "node --env-file=.env src/scripts/repair-legacy-slots.js --apply",
    "test": "node --test test/security.test.js",
    "test:workflow": "node --env-file=.env --test test/workflow.test.js",
    "test:head": "node --env-file=.env --test test/head.test.js",
    "test:lecturers": "node --env-file=.env --test test/head-lecturers.test.js",
    "test:import": "node --env-file=.env --test test/import.test.js",
    "format:check": "prettier --check src test",
    "test:affairs": "node --env-file=.env --test test/student-affairs.test.js",
    "academics:preview": "node --env-file=.env src/scripts/academic-calendar.js",
    "academics:normalize": "node --env-file=.env src/scripts/academic-calendar.js --apply",
    "seed:affairs": "npm run seed",
    "scope:preview": "node --env-file=.env src/scripts/migrate-scope.js",
    "scope:migrate": "node --env-file=.env src/scripts/migrate-scope.js --apply",
    "setup:session": "node --env-file=.env src/scripts/setup-session.js",
    "test:seed": "node --env-file=.env --test test/seed.test.js",
    "db:migrate:preview": "node --env-file=.env src/scripts/migrate-collections.js",
    "db:migrate": "node --env-file=.env src/scripts/migrate-collections.js --apply"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  }
}
