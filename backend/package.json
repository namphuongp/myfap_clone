{
  "name": "myfap-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:init": "node --env-file=.env src/init-db.js",
    "db:replica": "node --env-file=.env src/init-replica.js",
    "seed": "node --env-file=.env src/seed.js",
    "demo:expand": "node --env-file=.env scripts/expand-demo.js",
    "import:legacy": "node --env-file=.env src/import-legacy.js",
    "slots:preview": "node --env-file=.env src/repair-legacy-slots.js",
    "slots:repair": "node --env-file=.env src/repair-legacy-slots.js --apply",
    "test": "node --test test/security.test.js",
    "test:workflow": "node --env-file=.env --test test/workflow.test.js",
    "test:import": "node --env-file=.env --test test/import.test.js",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  }
}
